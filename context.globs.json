{
  "pattern": "unknown",
  "globs": {
    "docs": [".docs/**/*.md", "docs/**/*.md", ".appydave/docs/**/*.md"],
    "types": ["packages/contracts/src/**/*.ts", "packages/shared/src/**/*.ts"],
    "config": ["*.config.*", "turbo.json", "tsconfig.base.json", ".mise.toml"],
    "services": ["apps/server/src/**/*.ts"],
    "components": ["apps/web/src/components/**/*.tsx"],
    "views": ["apps/web/src/routes/**/*.tsx"],
    "tests": ["**/*.test.ts", "**/*.spec.ts"],
    "styles": ["**/*.css"],
    "context": ["CLAUDE.md", "AGENTS.md", "CONTEXT.md", ".claude/CLAUDE.md"]
  },
  "aliases": {
    "backend": ["services", "types"],
    "frontend": ["components", "views", "styles"],
    "appydave": ["styles", "context"]
  },
  "composites": {
    "understand": ["context", "docs", "types", "config"],
    "codebase": ["services", "components", "views"],
    "full": ["*"]
  }
}
