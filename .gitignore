# AppyDave: design-poc uploads (40MB of pasted source images, not needed for implementation)
.appydave/design-poc/appyctrl/project/uploads/

# AppyDave: SQLite WAL files from Ruflo memory init
.swarm/*.db-shm
.swarm/*.db-wal

# AppyDave: ruflo hooks leak .claude-flow/ into subdirs they touch — only commit the project root one
.appydave/design-poc/**/.claude-flow/

# Ruflo hook leakage — .claude-flow/ resolves relative to pwd, not project root.
# Subagents that cd into subdirs leave behind nested .claude-flow/ trees.
**/.claude-flow/
!/.claude-flow/
